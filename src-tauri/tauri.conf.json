{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Collector to Lazer",
  "version": "0.1.1",
  "identifier": "com.collector2lazer.app",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Collector → Lazer",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "useLocalToolsDir": true,
    "shortDescription": "osu!collector → osu!lazer",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxQkMzMUUxM0I2QzVFREQKUldUZFhtdzc0VEc4UVp3SXNuZjQ5bmV1VHlFc0Y0bzkzSEpRaGtxcDI4aTQ5L0w2YzFHQTFEbmgK",
      "endpoints": [
        "https://github.com/X4vi3/osu-collector-lazer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
